{
  "uid": "aerobooking-overview",
  "title": "AeroBooking \u2014 Wave 2 Overview",
  "tags": [
    "aerobooking",
    "wave2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(aerobooking_http_requests_total[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency (seconds)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(aerobooking_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Application logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "{container=~\".*(auth|search|booking|airline|audit).*\"}"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      }
    }
  ]
}