# =============================================================================
# AeroBooking - variables de entorno para infraestructura local
# =============================================================================
# Copiar este archivo a .env antes de levantar el stack:
#
#   cp .env.example .env
#
# El archivo .env NO se versiona porque contiene secretos de desarrollo.
# Los valores de ejemplo deben cambiarse antes de compartir el entorno.
# =============================================================================

# Nombre del proyecto Compose. Se usa como prefijo de red y volumenes.
COMPOSE_PROJECT_NAME=aerobooking

# -----------------------------------------------------------------------------
# Fase 2 - PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_APP_USER=aerobooking_app
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_AUDIT_USER=aerobooking_audit
POSTGRES_AUDIT_PASSWORD=change-me-audit
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Fase 2 - Valkey (cache, locks e idempotencia)
# -----------------------------------------------------------------------------
VALKEY_PASSWORD=change-me-valkey
VALKEY_PORT=6379

# -----------------------------------------------------------------------------
# Fase 2 - RabbitMQ (bus de eventos)
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=aerobooking
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Fase 3 - Kong (API Gateway)
# -----------------------------------------------------------------------------
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Fase 4 - Jaeger (obligatorio, perfil core)
# -----------------------------------------------------------------------------
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# -----------------------------------------------------------------------------
# Fase 5 - Observabilidad opcional (Loki, Grafana, Alloy)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345

# -----------------------------------------------------------------------------
# Fase 6 - Mock de aerolinea (perfil mock)
# -----------------------------------------------------------------------------
MOCK_AIRLINE_PORT=8089
AIRLINE_API_URL=http://mock-airline:8080
