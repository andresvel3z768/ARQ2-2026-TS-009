NODE_ENV=development
JWT_ISSUER=demo-client
JWT_AUDIENCE=aerobooking
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_TTL_SECONDS=900
DEMO_CLIENT_ID=demo-client
DEMO_CLIENT_SECRET=demo-secret-change-me
DEMO_ADMIN_SECRET=demo-admin-secret-change-me
DEMO_ADMIN_CLIENT_ID=demo-admin
DEMO_AGENCY_ID=00000000-0000-4000-8000-000000000009
DATABASE_URL=postgres://aerobooking:aerobooking_dev@postgres:5432/booking_db
REDIS_URL=redis://valkey:6379
RABBITMQ_URL=amqp://aerobooking:aerobooking_dev@rabbitmq:5672
AUTH_URL=http://auth-service:3001
SEARCH_URL=http://search-service:3002
AIRLINE_CONNECTOR_URL=http://airline-connector:3004
AIRLINE_REJECT_SEATS=12A
AIRLINE_RATE_CAPACITY=10
AIRLINE_RATE_REFILL_PER_SECOND=2
FARE_TTL_SECONDS=60
FARE_STALE_SECONDS=15
SEAT_LOCK_TTL_MS=120000
PORT=3000

PROVISIONING_SECRET=local-provisioning-secret-change-me
